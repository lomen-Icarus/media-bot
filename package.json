{
  "name": "media-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Бот вотермарок медиа-ВИШ: Telegram и МАКС одновременно",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "grammy": "^1.46.0",
    "pino": "^10.4.0",
    "sharp": "^0.35.5",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
