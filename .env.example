# ── Мессенджеры: нужен хотя бы один токен ──
# Telegram: @BotFather → /newbot → токен.
BOT_TOKEN=
# МАКС: business.max.ru → Чат-боты → бот → «⋮» → Настройки → токен (нужен верифицированный ИП/организация).
MAX_BOT_TOKEN=

# ── Кто админ (добавляет вотермарки в базу, выдаёт доступ) ──
# id через запятую. Свой id бот пишет по /id (или в ответе «нет доступа»).
# Чтобы получать запросы на доступ, админ должен хоть раз написать боту в этом мессенджере.
TG_ADMIN_IDS=
MAX_ADMIN_IDS=

# ── Доступ без запроса (необязательно): медиакоманда по id ──
# Остальные просят доступ сами — админам приходит кнопка «✅ Пустить».
TG_ALLOWED_IDS=
MAX_ALLOWED_IDS=

# Где лежат база (media-bot.sqlite) и временные фото.
DATA_DIR=./data
# Сколько часов хранить присланные фото, чтобы кнопки под результатом могли их переделать (0.1–72).
BATCH_TTL_HOURS=6

# Прокси для запросов к МАКС (необязательно).
HTTPS_PROXY=
LOG_LEVEL=info
